{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkd.dev/schema/task/result-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "taskId", "repository", "taskBranch", "baseSha", "implementationHead", "deliveryHead", "claimId", "executionBundleDigest", "candidateOutputBundleDigest", "scopes", "scopeDigest", "generatedAt", "generator", "manifestDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "candidate-result-manifest"},
    "taskId": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "taskBranch": {"type": "string", "minLength": 1},
    "baseSha": {"$ref": "#/$defs/sha1"},
    "implementationHead": {"$ref": "#/$defs/sha1"},
    "deliveryHead": {"$ref": "#/$defs/sha1"},
    "claimId": {"$ref": "#/$defs/sha256"},
    "executionBundleDigest": {"$ref": "#/$defs/sha256"},
    "candidateOutputBundleDigest": {"$ref": "#/$defs/sha256"},
    "scopes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "resultDigest"], "properties": {"name": {"type": "string", "minLength": 1}, "resultDigest": {"$ref": "#/$defs/sha256"}}}},
    "scopeDigest": {"$ref": "#/$defs/sha256"},
    "generatedAt": {"type": "string"},
    "generator": {"type": "string", "minLength": 1},
    "manifestDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
