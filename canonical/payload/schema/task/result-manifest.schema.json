{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gkd://schema/task/result-manifest-v2",
  "oneOf": [
    {"$ref": "#/$defs/legacy"},
    {"$ref": "#/$defs/lane"}
  ],
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "taskId", "repository", "taskBranch", "taskPath", "baseSha", "candidateOutputBundleDigest", "verifierResultDigest", "evidenceDigest", "manifestDigest"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "automatic-delivery-result-manifest"},
        "taskId": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "taskBranch": {"type": "string", "minLength": 1},
        "taskPath": {"type": "string", "minLength": 1},
        "baseSha": {"$ref": "#/$defs/sha1"},
        "candidateOutputBundleDigest": {"$ref": "#/$defs/sha256"},
        "verifierResultDigest": {"$ref": "#/$defs/sha256"},
        "evidenceDigest": {"$ref": "#/$defs/sha256"},
        "manifestDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "taskId", "repository", "taskBranch", "taskPath", "baseSha", "candidateOutputBundleDigest", "verifierResultDigest", "evidenceDigest", "manifestDigest", "lane", "profile", "scopes"],
      "properties": {
        "schemaVersion": {"const": 2},
        "kind": {"const": "automatic-delivery-result-manifest"},
        "taskId": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "taskBranch": {"type": "string", "minLength": 1},
        "taskPath": {"type": "string", "minLength": 1},
        "baseSha": {"$ref": "#/$defs/sha1"},
        "candidateOutputBundleDigest": {"$ref": "#/$defs/sha256"},
        "verifierResultDigest": {"$ref": "#/$defs/sha256"},
        "evidenceDigest": {"$ref": "#/$defs/sha256"},
        "manifestDigest": {"$ref": "#/$defs/sha256"},
        "lane": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "scopes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      }
    }
  }
}
