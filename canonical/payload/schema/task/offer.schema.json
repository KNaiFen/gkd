{
  "$id": "gkd://schema/task/offer-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "schemaVersion": {"type": "integer"},
        "offerId": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["active", "consumed", "revoked"]},
        "epoch": {"type": "integer", "minimum": 0},
        "taskId": {"type": "string"},
        "repository": {"type": "string"},
        "taskBranch": {"type": "string"},
        "expectedHead": {"$ref": "#/$defs/sha1"},
        "expectedRevision": {"type": "integer", "minimum": 0},
        "route": {"type": "string"},
        "planVersion": {"type": "integer", "minimum": 1},
        "planMaterialDigest": {"$ref": "#/$defs/sha256"},
        "authorizationDigest": {"$ref": "#/$defs/sha256"},
        "allowedActions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "roleDigest": {"$ref": "#/$defs/sha256"},
        "configDigest": {"$ref": "#/$defs/sha256"},
        "capabilityDigest": {"$ref": "#/$defs/sha256"},
        "createdAt": {"type": "string"},
        "expiresAt": {"type": "string"},
        "consumedByDigest": {"type": ["string", "null"]}
      },
      "required": ["schemaVersion", "offerId", "status", "epoch", "taskId", "repository", "taskBranch", "expectedHead", "expectedRevision", "route", "planVersion", "planMaterialDigest", "authorizationDigest", "allowedActions", "roleDigest", "configDigest", "capabilityDigest", "createdAt", "expiresAt", "consumedByDigest"]
    },
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activationProviderReady": {"const": true},
        "bundleFixed": {"const": true},
        "offerClaimReady": {"const": true},
        "roleAvailable": {"const": true},
        "roleConfigFixed": {"const": true},
        "waitGateReady": {"const": true}
      },
      "required": ["activationProviderReady", "bundleFixed", "offerClaimReady", "roleAvailable", "roleConfigFixed", "waitGateReady"]
    },
    "v1": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"properties": {"schemaVersion": {"const": 1}, "route": {"not": {"const": "automatic"}}}}
      ]
    },
    "v2": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "schemaVersion": {"const": 2},
            "route": {"not": {"const": "automatic"}},
            "roleName": {"type": "string"},
            "bundleDigest": {"$ref": "#/$defs/sha256"}
          },
          "required": ["roleName", "bundleDigest"]
        }
      ]
    },
    "v3": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "schemaVersion": {"const": 3},
            "route": {"const": "automatic"},
            "roleName": {"const": "gkd_executor"},
            "bundleDigest": {"$ref": "#/$defs/sha256"},
            "routeDecisionDigest": {"$ref": "#/$defs/sha256"},
            "routeGates": {"$ref": "#/$defs/gates"}
          },
          "required": ["roleName", "bundleDigest", "routeDecisionDigest", "routeGates"]
        }
      ]
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"},
    {"$ref": "#/$defs/v3"}
  ]
}
