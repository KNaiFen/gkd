{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gkd://schema/task/authorization-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorizationId", "taskId", "repository", "baseBranch", "baseSha", "taskBranch", "planVersion", "materialDigest", "mode", "allowedActions", "decisionRef", "recordedAt", "authorizationDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "authorizationId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "taskId": {"type": "string"},
    "repository": {"type": "string"},
    "baseBranch": {"type": "string"},
    "baseSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "taskBranch": {"type": "string"},
    "planVersion": {"type": "integer", "minimum": 1},
    "materialDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mode": {"enum": ["implement_only", "implement_and_merge_on_acceptance"]},
    "allowedActions": {"type": "array", "uniqueItems": true, "items": {"enum": ["commit", "push", "pr_update", "ci_repair", "ready_for_review", "conditional_merge"]}},
    "decisionRef": {"type": "string"},
    "recordedAt": {"type": "string"},
    "authorizationDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
