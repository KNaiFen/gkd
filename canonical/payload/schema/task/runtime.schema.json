{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gkd://schema/task/runtime-v1",
  "oneOf": [
    {"$ref": "#/$defs/attachment"},
    {"$ref": "#/$defs/capability"},
    {"$ref": "#/$defs/envelope"},
    {"$ref": "#/$defs/envelopeV2"},
    {"$ref": "#/$defs/claimReceipt"},
    {"$ref": "#/$defs/activation"},
    {"$ref": "#/$defs/activationReceipt"},
    {"$ref": "#/$defs/journal"}
  ],
  "$defs": {
    "attachment": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "repository", "taskId", "taskBranch", "taskPath", "candidateRoot", "commonDir", "updatedAt", "attachmentDigest"], "properties": {"schemaVersion": {"const": 1}, "kind": {"const": "attachment"}, "repository": {"type": "string"}, "taskId": {"type": "string"}, "taskBranch": {"type": "string"}, "taskPath": {"type": "string"}, "candidateRoot": {"type": "string"}, "commonDir": {"type": "string"}, "updatedAt": {"type": "string"}, "attachmentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "capability": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "offerId", "epoch", "capability", "capabilityDigest", "createdAt"], "properties": {"schemaVersion": {"const": 1}, "kind": {"const": "capability"}, "offerId": {"type": "string"}, "epoch": {"type": "integer"}, "capability": {"type": "string"}, "capabilityDigest": {"type": "string"}, "createdAt": {"type": "string"}}},
    "envelope": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "envelopeId", "offerId", "epoch", "capability", "candidateRoot", "taskPath", "route", "roleDigest", "configDigest", "createdAt", "envelopeDigest"], "properties": {"schemaVersion": {"const": 1}, "kind": {"const": "launch-envelope"}, "envelopeId": {"type": "string"}, "offerId": {"type": "string"}, "epoch": {"type": "integer"}, "capability": {"type": "string"}, "candidateRoot": {"type": "string"}, "taskPath": {"type": "string"}, "route": {"type": "string"}, "roleDigest": {"type": "string"}, "configDigest": {"type": "string"}, "createdAt": {"type": "string"}, "envelopeDigest": {"type": "string"}}},
    "envelopeV2": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "envelopeId", "offerId", "epoch", "capability", "candidateRoot", "taskPath", "route", "roleName", "roleDigest", "configDigest", "bundleDigest", "createdAt", "envelopeDigest"], "properties": {"schemaVersion": {"const": 1}, "kind": {"const": "launch-envelope"}, "envelopeId": {"type": "string"}, "offerId": {"type": "string"}, "epoch": {"type": "integer"}, "capability": {"type": "string"}, "candidateRoot": {"type": "string"}, "taskPath": {"type": "string"}, "route": {"type": "string"}, "roleName": {"type": "string"}, "roleDigest": {"type": "string"}, "configDigest": {"type": "string"}, "bundleDigest": {"type": "string"}, "createdAt": {"type": "string"}, "envelopeDigest": {"type": "string"}}},
    "claimReceipt": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "taskId", "repository", "taskBranch", "taskPath", "offerId", "claimId", "epoch", "claimBaseHead", "claimCommit", "claimStateDigest", "offerDigest", "transactionId", "transactionDigest", "recordedAt", "receiptDigest"], "properties": {"schemaVersion": {"const": 1}, "kind": {"const": "claim-receipt"}, "taskId": {"type": "string"}, "repository": {"type": "string"}, "taskBranch": {"type": "string"}, "taskPath": {"type": "string"}, "offerId": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "claimId": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "epoch": {"type": "integer", "minimum": 0}, "claimBaseHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "claimCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "claimStateDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "offerDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "transactionId": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "transactionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "recordedAt": {"type": "string"}, "receiptDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "activation": {"$ref": "../role/activation.schema.json"},
    "activationReceipt": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "activationId", "activationDigest", "claimId", "claimCommit", "claimReceiptDigest", "consumedAt", "receiptDigest"], "properties": {"schemaVersion": {"const": 1}, "kind": {"const": "activation-receipt"}, "activationId": {"type": "string"}, "activationDigest": {"type": "string"}, "claimId": {"type": "string"}, "claimCommit": {"type": "string"}, "claimReceiptDigest": {"type": "string"}, "consumedAt": {"type": "string"}, "receiptDigest": {"type": "string"}}},
    "journal": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "transactionId", "runtimeKey", "status", "expectedHead", "expectedRevision", "files", "createdAt", "committedHead", "journalDigest"], "properties": {"schemaVersion": {"const": 1}, "transactionId": {"type": "string"}, "runtimeKey": {"type": "string"}, "status": {"enum": ["prepared", "committed", "rolled_back"]}, "expectedHead": {"type": "string"}, "expectedRevision": {"type": "integer"}, "files": {"type": "array"}, "createdAt": {"type": "string"}, "committedHead": {"type": ["string", "null"]}, "journalDigest": {"type": "string"}}}
  }
}
