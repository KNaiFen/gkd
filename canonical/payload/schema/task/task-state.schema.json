{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gkd://schema/task/task-state-v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "revision", "repository", "documents", "approval", "implementationAuthorization", "actionAuthorizationDigest", "lifecycle", "history", "integrityDigest"],
  "properties": {
    "schemaVersion": {"enum": [1, 2, 3, 4]},
    "taskId": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "repository": {"$ref": "#/$defs/repository"},
    "documents": {"$ref": "#/$defs/documents"},
    "approval": {"type": ["object", "null"]},
    "implementationAuthorization": {"type": ["object", "null"]},
    "actionAuthorizationDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "history": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "integrityDigest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"schemaVersion": {"enum": [1, 3]}}}, "then": {"properties": {"lifecycle": {"not": {"required": ["rejectedAttempts"]}}}}},
    {"if": {"properties": {"schemaVersion": {"enum": [2, 4]}}}, "then": {"properties": {"lifecycle": {"required": ["rejectedAttempts"], "properties": {"rejectedAttempts": {"minItems": 1}}}}}},
    {"if": {"properties": {"schemaVersion": {"enum": [1, 2]}}}, "then": {"properties": {"repository": {"not": {"required": ["policy"]}}}}},
    {"if": {"properties": {"schemaVersion": {"enum": [3, 4]}}}, "then": {"properties": {"repository": {"required": ["policy"]}}}}
  ],
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "baseBranch", "baseSha", "taskBranch", "taskPath"],
      "properties": {
        "identity": {"type": "string"},
        "baseBranch": {"type": "string"},
        "baseSha": {"$ref": "#/$defs/sha1"},
        "taskBranch": {"type": "string"},
        "taskPath": {"type": "string"},
        "policy": {"$ref": "#/$defs/policy"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "provider", "repository", "baseBranch", "requiredChecks"],
      "properties": {
        "path": {"const": ".gkd/policy.json"},
        "digest": {"$ref": "#/$defs/sha256"},
        "provider": {"const": "github"},
        "repository": {"type": "string"},
        "baseBranch": {"type": "string"},
        "requiredChecks": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "plan", "implementation"],
      "properties": {
        "requirements": {"type": "object", "additionalProperties": false, "required": ["path", "version", "documentRevision", "digest", "status"], "properties": {"path": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "documentRevision": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/sha256"}, "status": {"enum": ["draft", "ready"]}}},
        "plan": {"type": "object", "additionalProperties": false, "required": ["path", "version", "documentRevision", "digest", "materialDigest", "status"], "properties": {"path": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "documentRevision": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/sha256"}, "materialDigest": {"$ref": "#/$defs/sha256"}, "status": {"enum": ["proposed", "approved"]}}},
        "implementation": {"type": "object", "additionalProperties": false, "required": ["path", "version", "documentRevision", "digest"], "properties": {"path": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "documentRevision": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/sha256"}}}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "epoch", "blocked", "writer", "offer", "claim", "retiredClaims", "delivery", "acceptance", "completion"],
      "properties": {
        "phase": {"enum": ["planning", "awaiting_claim", "implementing", "delivered", "accepted", "completed"]},
        "epoch": {"type": "integer", "minimum": 0},
        "blocked": {"type": ["object", "null"]},
        "writer": {"type": ["object", "null"]},
        "offer": {"type": ["object", "null"]},
        "claim": {"type": ["object", "null"]},
        "retiredClaims": {"type": "array"},
        "rejectedAttempts": {"type": "array", "items": {"$ref": "#/$defs/rejectedAttempt"}},
        "delivery": {"anyOf": [{"$ref": "#/$defs/delivery"}, {"type": "null"}]},
        "acceptance": {"type": ["object", "null"]},
        "completion": {"type": ["object", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"phase": {"const": "planning"}}}, "then": {"properties": {"writer": {"type": "null"}, "offer": {"type": "null"}, "claim": {"type": "null"}, "delivery": {"type": "null"}, "acceptance": {"type": "null"}, "completion": {"type": "null"}}}},
        {"if": {"properties": {"phase": {"const": "awaiting_claim"}}}, "then": {"properties": {"writer": {"type": "null"}, "offer": {"type": "object"}, "claim": {"type": "null"}, "delivery": {"type": "null"}, "acceptance": {"type": "null"}, "completion": {"type": "null"}}}},
        {"if": {"properties": {"phase": {"const": "implementing"}}}, "then": {"properties": {"writer": {"type": "object"}, "offer": {"type": "object"}, "claim": {"type": "object"}, "delivery": {"type": "null"}, "acceptance": {"type": "null"}, "completion": {"type": "null"}}}},
        {"if": {"properties": {"phase": {"const": "delivered"}}}, "then": {"properties": {"writer": {"type": "null"}, "offer": {"type": "object"}, "claim": {"type": "object"}, "delivery": {"type": "object"}, "acceptance": {"type": "null"}, "completion": {"type": "null"}}}},
        {"if": {"properties": {"phase": {"const": "accepted"}}}, "then": {"properties": {"writer": {"type": "null"}, "offer": {"type": "object"}, "claim": {"type": "object"}, "delivery": {"type": "object"}, "acceptance": {"type": "object"}, "completion": {"type": "null"}}}},
        {"if": {"properties": {"phase": {"const": "completed"}}}, "then": {"properties": {"writer": {"type": "null"}, "offer": {"type": "object"}, "claim": {"type": "object"}, "delivery": {"type": "object"}, "acceptance": {"type": "object"}, "completion": {"type": "object"}}}}
      ]
    },
    "rejectedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taskId", "repository", "prNumber", "baseBranch", "taskBranch", "candidateHead", "epoch", "offer", "claim", "delivery", "claimReceiptDigest", "activationReceiptDigest", "reviewDigest", "findingsDigest", "rejectedAt"],
      "properties": {
        "schemaVersion": {"const": 1},
        "taskId": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "prNumber": {"type": "integer", "minimum": 1},
        "baseBranch": {"type": "string", "minLength": 1},
        "taskBranch": {"type": "string", "minLength": 1},
        "candidateHead": {"$ref": "#/$defs/sha1"},
        "epoch": {"type": "integer", "minimum": 0},
        "offer": {"type": "object"},
        "claim": {"type": "object"},
        "delivery": {"type": "object"},
        "claimReceiptDigest": {"$ref": "#/$defs/sha256"},
        "activationReceiptDigest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "reviewDigest": {"$ref": "#/$defs/sha256"},
        "findingsDigest": {"$ref": "#/$defs/sha256"},
        "rejectedAt": {"type": "string"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementationHead", "claimId", "deliveredAt"],
      "properties": {
        "implementationHead": {"$ref": "#/$defs/sha1"},
        "deliveryDocumentCommit": {"$ref": "#/$defs/sha1"},
        "deliveryDocumentPath": {"type": "string"},
        "deliveryDocumentDigest": {"$ref": "#/$defs/sha256"},
        "claimId": {"$ref": "#/$defs/sha256"},
        "deliveredAt": {"type": "string"},
        "executionBundleDigest": {"$ref": "#/$defs/sha256"},
        "candidateOutputBundleDigest": {"$ref": "#/$defs/sha256"},
        "routeDecisionDigest": {"$ref": "#/$defs/sha256"}
      },
      "oneOf": [
        {"not": {"anyOf": [{"required": ["deliveryDocumentCommit"]}, {"required": ["deliveryDocumentPath"]}, {"required": ["deliveryDocumentDigest"]}]}},
        {"required": ["deliveryDocumentCommit", "deliveryDocumentPath", "deliveryDocumentDigest"]}
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "type", "at", "head", "recordDigest"],
      "properties": {"revision": {"type": "integer", "minimum": 0}, "type": {"enum": ["bootstrap", "requirements_ready", "plan_proposed", "plan_approved", "authorized", "offer_created", "claimed", "revoked", "reclaimed", "blocked", "resumed", "delivered", "reworked", "accepted", "completed", "migrated_v1", "planning_refreshed"]}, "at": {"type": "string"}, "head": {"anyOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]}, "recordDigest": {"$ref": "#/$defs/sha256"}}
    }
  }
}
