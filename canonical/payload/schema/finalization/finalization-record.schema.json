{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gkd://schema/finalization/finalization-record-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "finalization", "metadata", "releaseIntent", "evidence", "assets", "provenance", "recordDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "task": {"type": "object"},
    "finalization": {"type": "object"},
    "metadata": {"type": "object"},
    "releaseIntent": {"type": "object"},
    "evidence": {"type": "object"},
    "assets": {"type": "array"},
    "provenance": {"type": "object"},
    "recordDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
