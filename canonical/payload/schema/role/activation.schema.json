{
  "$id": "gkd://schema/role/activation-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 2},
    "kind": {"const": "role-activation"},
    "activationId": {"$ref": "#/$defs/sha256"},
    "taskId": {"type": "string"},
    "repository": {"type": "string"},
    "taskBranch": {"type": "string"},
    "offerId": {"$ref": "#/$defs/sha256"},
    "envelopeId": {"$ref": "#/$defs/sha256"},
    "offerCreatedAt": {"type": "string"},
    "offerExpiresAt": {"type": "string"},
    "route": {"type": "string"},
    "routeDecisionDigest": {"$ref": "#/$defs/sha256"},
    "executorTaskName": {"type": "string"},
    "executorAttemptDigest": {"$ref": "#/$defs/sha256"},
    "roleName": {"type": "string"},
    "roleDigest": {"$ref": "#/$defs/sha256"},
    "configDigest": {"$ref": "#/$defs/sha256"},
    "bundleDigest": {"$ref": "#/$defs/sha256"},
    "configuredModel": {"type": "string"},
    "configuredReasoningEffort": {"type": "string"},
    "configuredSandbox": {"type": "string"},
    "runtimeSeconds": {"type": "integer"},
    "acknowledgedAt": {"type": "string"},
    "evidenceClass": {"const": "host-spawn-acknowledgement"},
    "providerName": {"type": "string"},
    "providerDigest": {"$ref": "#/$defs/sha256"},
    "activationDigest": {"$ref": "#/$defs/sha256"}
  },
  "required": ["schemaVersion", "kind", "activationId", "taskId", "repository", "taskBranch", "offerId", "envelopeId", "offerCreatedAt", "offerExpiresAt", "route", "executorTaskName", "executorAttemptDigest", "roleName", "roleDigest", "configDigest", "bundleDigest", "configuredModel", "configuredReasoningEffort", "configuredSandbox", "runtimeSeconds", "acknowledgedAt", "evidenceClass", "providerName", "providerDigest", "activationDigest"],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "type": "object"
}
