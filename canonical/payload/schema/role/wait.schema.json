{
  "$id": "gkd://schema/role/wait-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"}
  ],
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base": {
      "type": "object",
      "properties": {
        "schemaVersion": {"type": "integer"}, "taskId": {"type": "string"},
        "repository": {"type": "string"}, "head": {"$ref": "#/$defs/sha1"},
        "claimId": {"$ref": "#/$defs/sha256"}, "bundleDigest": {"$ref": "#/$defs/sha256"},
        "startedAt": {"type": "string"}, "deadlineAt": {"type": "string"},
        "completedIntervals": {"type": "integer", "minimum": 0, "maximum": 12},
        "interruptIssued": {"type": "boolean"}, "terminal": {"type": ["object", "null"]},
        "stateDigest": {"$ref": "#/$defs/sha256"}
      },
      "required": ["schemaVersion", "taskId", "repository", "head", "claimId", "bundleDigest", "startedAt", "deadlineAt", "completedIntervals", "interruptIssued", "terminal", "stateDigest"]
    },
    "v1": {
      "type": "object", "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"properties": {"schemaVersion": {"const": 1}, "agentId": {"type": "string"}, "sessionDigest": {"$ref": "#/$defs/sha256"}}, "required": ["agentId", "sessionDigest"]}
      ]
    },
    "v2": {
      "type": "object", "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"properties": {"schemaVersion": {"const": 2}, "executorTaskName": {"type": "string"}, "executorAttemptDigest": {"$ref": "#/$defs/sha256"}}, "required": ["executorTaskName", "executorAttemptDigest"]}
      ]
    }
  }
}
