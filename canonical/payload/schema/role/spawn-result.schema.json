{
  "$id": "gkd://schema/role/spawn-result-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 2},
    "status": {"const": "spawned"},
    "spawnCount": {"const": 1},
    "taskName": {"type": "string"},
    "agentType": {"const": "gkd_executor"},
    "forkTurns": {"const": "none"},
    "fallbackAttempted": {"const": false}
