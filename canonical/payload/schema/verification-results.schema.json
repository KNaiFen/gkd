{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkd.dev/schema/verification-results.schema.json",
  "title": "Canonical verification results",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/scope" }
  ],
  "$defs": {
    "scopeName": {
      "enum": [
        "m5-release-candidate",
        "m4-finalization",
        "m3-ci-policy",
        "m3-resource-scanner",
        "m3-review-core",
        "task-core",
        "role-routing",
        "runtime-bridge",
        "p1-production-migration",
        "foundation",
        "watcher-core-and-live-negative"
      ]
    },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependenciesInstalled", "platform", "pythonVersion"],
      "properties": {
        "dependenciesInstalled": { "const": false },
        "platform": { "type": "string", "minLength": 1 },
        "pythonVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "error", "skip"] }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseSha", "environment", "headSha", "manifestDigest", "schemaVersion", "scopes", "verifierDigest"],
      "properties": {
        "baseSha": { "$ref": "#/$defs/sha1" },
        "environment": { "$ref": "#/$defs/environment" },
        "headSha": { "$ref": "#/$defs/sha1" },
        "manifestDigest": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "const": 1 },
        "scopes": { "type": "array", "items": { "$ref": "#/$defs/scopeName" }, "minItems": 1 },
        "verifierDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseSha", "environment", "headSha", "resultDigest", "schemaVersion", "scope", "status", "tests", "verifierDigest"],
      "properties": {
        "baseSha": { "$ref": "#/$defs/sha1" },
        "environment": { "$ref": "#/$defs/environment" },
        "headSha": { "$ref": "#/$defs/sha1" },
        "resultDigest": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "const": 1 },
        "scope": { "$ref": "#/$defs/scopeName" },
        "status": { "enum": ["pass", "fail"] },
        "tests": { "type": "array", "items": { "$ref": "#/$defs/test" }, "minItems": 1 },
        "verifierDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
