{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkd.dev/schema/verification-results.schema.json",
  "title": "Canonical verification results",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/scope" }
  ],
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependenciesInstalled", "platform", "pythonVersion"],
      "properties": {
        "dependenciesInstalled": { "const": false },
        "platform": { "type": "string", "minLength": 1 },
        "pythonVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "error", "skip"] }
      }
    },
    "legacyManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseSha", "environment", "headSha", "manifestDigest", "schemaVersion", "scopes", "verifierDigest"],
      "properties": {
        "baseSha": { "$ref": "#/$defs/sha1" },
        "environment": { "$ref": "#/$defs/environment" },
        "headSha": { "$ref": "#/$defs/sha1" },
        "manifestDigest": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "const": 1 },
        "scopes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "verifierDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "laneManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseSha", "environment", "headSha", "lane", "manifestDigest", "profile", "schemaVersion", "scopes", "verifierDigest"],
      "properties": {
        "baseSha": { "$ref": "#/$defs/sha1" },
        "environment": { "$ref": "#/$defs/environment" },
        "headSha": { "$ref": "#/$defs/sha1" },
        "lane": { "type": "string", "minLength": 1 },
        "manifestDigest": { "$ref": "#/$defs/sha256" },
        "profile": { "type": "string", "minLength": 1 },
        "schemaVersion": { "const": 2 },
        "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "verifierDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "manifest": {
      "oneOf": [
        { "$ref": "#/$defs/legacyManifest" },
        { "$ref": "#/$defs/laneManifest" }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseSha", "environment", "headSha", "resultDigest", "schemaVersion", "scope", "status", "tests", "verifierDigest"],
      "properties": {
        "baseSha": { "$ref": "#/$defs/sha1" },
        "environment": { "$ref": "#/$defs/environment" },
        "headSha": { "$ref": "#/$defs/sha1" },
        "resultDigest": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "const": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail"] },
        "tests": { "type": "array", "items": { "$ref": "#/$defs/test" }, "minItems": 1 },
        "verifierDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
