{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactClass", "artifacts", "peakBytes", "preset", "outcome", "reason"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactClass": { "enum": ["zero", "bounded", "build-or-unknown"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "name", "artifactClass", "maxBytes", "peakBytes", "decision", "reason"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "name": { "type": "string", "minLength": 1 },
          "artifactClass": { "enum": ["zero", "bounded", "build-or-unknown"] },
          "maxBytes": { "type": ["integer", "null"], "minimum": 0 },
          "peakBytes": { "type": ["integer", "null"], "minimum": 0 },
          "decision": { "enum": ["allow", "blocked"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "peakBytes": { "type": ["integer", "null"], "minimum": 0 },
    "preset": { "type": "object" },
    "outcome": { "enum": ["allow", "blocked"] },
    "reason": { "type": "string", "minLength": 1 }
  }
}
