{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "visibility", "runner", "policy", "billing", "resource"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "visibility": { "enum": ["public", "private", "internal", "unknown"] },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "kind", "capacity", "os", "verified"],
      "properties": {
        "provider": { "enum": ["github", "unknown"] },
        "kind": { "enum": ["github-hosted", "self-hosted", "unknown"] },
        "capacity": { "enum": ["resource-constrained", "standard", "high-capacity", "unknown"] },
        "os": { "enum": ["linux", "macos", "windows", "unknown"] },
        "verified": { "type": "boolean" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseBranch", "requiredChecks", "policyDigest", "verified"],
      "properties": {
        "baseBranch": { "type": "string", "minLength": 1 },
        "requiredChecks": { "type": "array", "items": { "type": "string" } },
        "policyDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "verified": { "type": "boolean" }
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "currency", "pricePerMinute", "verified", "checkedAt"],
      "properties": {
        "source": { "enum": ["github-public-pricing", "provider-contract", "unknown"] },
        "currency": { "type": ["string", "null"] },
        "pricePerMinute": { "type": ["number", "null"], "minimum": 0 },
        "verified": { "type": "boolean" },
        "checkedAt": { "type": ["string", "null"] }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availableDiskBytes", "memoryBytes", "cpuCount", "source", "verified"],
      "properties": {
        "availableDiskBytes": { "type": ["integer", "null"], "minimum": 0 },
        "memoryBytes": { "type": ["integer", "null"], "minimum": 0 },
        "cpuCount": { "type": ["integer", "null"], "minimum": 0 },
        "source": { "enum": ["host", "runner", "observed", "unknown"] },
        "verified": { "type": "boolean" }
      }
    }
  }
}
