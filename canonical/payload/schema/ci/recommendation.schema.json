{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "goal", "preset", "runnerAction", "price", "priceReason", "visibility", "runner", "policy", "resource", "artifactPlan", "outcome", "recommendationDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "goal": { "enum": ["speed-first", "balanced", "cost-aware"] },
    "preset": { "enum": ["resource-constrained", "standard", "high-capacity"] },
    "runnerAction": { "type": "string", "minLength": 1 },
    "price": { "type": "object" },
    "priceReason": { "type": "string", "minLength": 1 },
    "visibility": { "enum": ["public", "private", "internal", "unknown"] },
    "runner": { "type": "object" },
    "policy": { "type": "object" },
    "resource": { "type": "object" },
    "artifactPlan": { "type": ["object", "null"] },
    "outcome": { "enum": ["recommended", "blocked"] },
    "recommendationDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
