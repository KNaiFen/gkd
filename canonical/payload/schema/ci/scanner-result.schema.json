{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surface", "inputDigest", "filesScanned", "findings", "outcome", "terminal"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "surface": { "enum": ["diff", "pull-request", "artifact"] },
    "inputDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "filesScanned": { "type": "integer", "minimum": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line", "path", "rule", "redaction"],
        "properties": {
          "line": { "type": "integer", "minimum": 1 },
          "path": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "redaction": { "const": "full-value" }
        }
      }
    },
    "outcome": { "enum": ["clean", "terminal"] },
    "terminal": { "type": "boolean" }
  }
}
