{
  "schemaVersion": 2,
  "title": "GKD bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleVersion",
    "releaseStatus",
    "components",
    "packs"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "bundleVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "releaseStatus": { "const": "release-candidate" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "files"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["executable", "library"] },
          "pack": { "type": "string" },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "target", "type", "mode"],
              "properties": {
                "source": { "type": "string" },
                "target": { "type": "string" },
                "type": { "const": "file" },
                "mode": { "enum": ["0644", "0755"] }
              }
            }
          }
        }
      }
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "components", "inputs"],
        "properties": {
          "name": { "type": "string" },
          "components": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "inputs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
