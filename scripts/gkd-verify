#!/usr/bin/env python3
"""Run the repository-approved zero-dependency local verification contract."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import unittest


ROOT = Path(__file__).resolve().parents[1]
LIBRARY = ROOT / "canonical" / "payload" / "lib"
sys.dont_write_bytecode = True
sys.path.insert(0, str(LIBRARY))
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "src"))

from gkd_task.results import (
    DEFAULT_SCOPE_NAMES,
    HISTORICAL_SCOPE_NAMES,
    canonical_bytes,
    write_manifest,
    write_scope_result,
)


SHA_RE = re.compile(r"^[0-9a-f]{40}$")
SCOPE_PATHS = {
    "m5-release-candidate": "tests/release_candidate",
    "m4-finalization": "tests/finalization",
    "m3-ci-policy": "tests/ci_policy",
    "m3-resource-scanner": "tests/resource_scanner",
    "m3-review-core": "tests/review_core",
    "task-core": "tests/task_core",
    "role-routing": "tests/role_routing",
    "runtime-bridge": "tests/runtime_bridge",
    "p1-production-migration": "tests/production_migration",
    "foundation": "tests/foundation",
    "watcher-core-and-live-negative": "tests/watchdog",
}
LANE_SCOPES = {
    "default": DEFAULT_SCOPE_NAMES,
    "historical": HISTORICAL_SCOPE_NAMES,
}


def _git(*arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ("git", *arguments),
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def _recording_result(*args, **kwargs):
    class RecordingResult(unittest.TextTestResult):
        def __init__(self, *inner_args, **inner_kwargs):
            super().__init__(*inner_args, **inner_kwargs)
            self.statuses: dict[str, str] = {}

        def addSuccess(self, test):
            super().addSuccess(test)
            self.statuses[test.id()] = "pass"

        def addFailure(self, test, err):
            super().addFailure(test, err)
            self.statuses[test.id()] = "fail"

        def addError(self, test, err):
            super().addError(test, err)
            self.statuses[test.id()] = "error"

        def addSkip(self, test, reason):
            super().addSkip(test, reason)
            self.statuses[test.id()] = "skip"

    return RecordingResult(*args, **kwargs)


def _flatten(suite: unittest.TestSuite):
    for item in suite:
        if isinstance(item, unittest.TestSuite):
            yield from _flatten(item)
        else:
            yield item


def _run_scope(name: str, relative: str, *, base_sha: str | None = None, head_sha: str | None = None, result_output: Path | None = None) -> int:
    suite = unittest.defaultTestLoader.discover(
        str(ROOT / relative),
        pattern="test_*.py",
        top_level_dir=str(ROOT),
    )
    tests = list(_flatten(suite))
    result = unittest.TextTestRunner(stream=sys.stderr, verbosity=2, warnings="error", resultclass=_recording_result).run(suite)
    if result_output is not None:
        statuses = [{"id": test.id(), "status": result.statuses.get(test.id(), "error")} for test in tests]
        write_scope_result(
            result_output,
            base_sha=base_sha or "0" * 40,
            head_sha=head_sha or _git("rev-parse", "HEAD").stdout.strip(),
            scope=name,
            tests=statuses,
            verifier_digest=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        )
    print(
        json.dumps(
            {
                "outcome": "pass" if result.wasSuccessful() else "fail",
                "scope": name,
                "tests": result.testsRun,
            },
            sort_keys=True,
            separators=(",", ":"),
        )
    )
    return 0 if result.wasSuccessful() else 1


def _historical_diagnostic(output: Path, results_dir: Path, reason: str) -> None:
    manifest = json.loads((results_dir / "manifest.json").read_text(encoding="utf-8"))
    output.write_bytes(
        canonical_bytes(
            {
                "canonicalResultsDigest": manifest["manifestDigest"],
                "outcome": "unsupported",
                "reason": reason,
                "schemaVersion": 1,
            }
        )
    )


def _run_historical_evidence(results_dir: Path, output: Path) -> str:
    command = [
        sys.executable,
        "-B",
        str(ROOT / "tests" / "watchdog" / "run_contracts.py"),
        "--output",
        str(output),
        "--canonical-results",
        str(results_dir),
    ]
    completed = subprocess.run(
        command,
        cwd=ROOT,
        env=os.environ.copy(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if completed.returncode == 0:
        return "core_ready_for_live_gate"
    _historical_diagnostic(output, results_dir, "HOST_CAPABILITY_UNAVAILABLE")
    return "unsupported"


def _run_host_capability_probe(output: Path) -> str:
    command = [
        sys.executable,
        "-B",
        str(ROOT / "probes" / "app-server-watcher" / "live_probe.py"),
        "--output",
        str(output),
    ]
    completed = subprocess.run(
        command,
        cwd=ROOT,
        env=os.environ.copy(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if completed.returncode == 0:
        return json.loads(output.read_text(encoding="utf-8"))["outcome"]
    output.write_bytes(
        canonical_bytes(
            {
                "outcome": "unsupported",
                "reason": "HOST_CAPABILITY_UNAVAILABLE",
                "schemaVersion": 1,
            }
        )
    )
    return "unsupported"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base-sha")
    parser.add_argument("--results-dir", type=Path)
    parser.add_argument("--summary-output", type=Path)
    parser.add_argument("--lane", choices=sorted(LANE_SCOPES), default="default")
    parser.add_argument("--historical-evidence-output", type=Path)
    parser.add_argument("--host-capability-probe-output", type=Path)
    parser.add_argument("--scope-internal", choices=sorted(SCOPE_PATHS), help=argparse.SUPPRESS)
    parser.add_argument("--result-output", type=Path, help=argparse.SUPPRESS)
    parser.add_argument("--head-sha", help=argparse.SUPPRESS)
    args = parser.parse_args()
    os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
    verification_paths = (ROOT / "src", LIBRARY, ROOT)
    os.environ["PYTHONPATH"] = os.pathsep.join(str(path) for path in verification_paths)
    if args.scope_internal is not None:
        relative = SCOPE_PATHS[args.scope_internal]
        return _run_scope(args.scope_internal, relative, base_sha=args.base_sha, head_sha=args.head_sha, result_output=args.result_output)
    if (args.historical_evidence_output is not None or args.host_capability_probe_output is not None) and args.lane != "historical":
        print(json.dumps({"error": "HISTORICAL_LANE_REQUIRED", "status": "error"}, sort_keys=True))
        return 2
    if args.base_sha is None:
        print(json.dumps({"error": "BASE_SHA_INVALID", "status": "error"}, sort_keys=True))
        return 2
    if not SHA_RE.fullmatch(args.base_sha):
        print(json.dumps({"error": "BASE_SHA_INVALID", "status": "error"}, sort_keys=True))
        return 2
    top = _git("rev-parse", "--show-toplevel")
    ancestor = _git("merge-base", "--is-ancestor", args.base_sha, "HEAD")
    if top.returncode != 0 or Path(top.stdout.strip()).resolve() != ROOT or ancestor.returncode != 0:
        print(json.dumps({"error": "BASE_SHA_NOT_ANCESTOR", "status": "error"}, sort_keys=True))
        return 2
    counts: dict[str, int] = {}
    passed = True
    head_sha = _git("rev-parse", "HEAD").stdout.strip()
    results_dir = args.results_dir
    if results_dir is not None:
        if results_dir.exists() and results_dir.is_symlink():
            print(json.dumps({"error": "RESULTS_DIR_INVALID", "status": "error"}, sort_keys=True))
            return 2
        results_dir.mkdir(parents=True, exist_ok=True)
        if not results_dir.is_dir() or any(results_dir.iterdir()):
            print(json.dumps({"error": "RESULTS_DIR_INVALID", "status": "error"}, sort_keys=True))
            return 2
    summary_output = args.summary_output
    if summary_output is not None:
        if summary_output.is_symlink() or summary_output.exists() or not summary_output.parent.is_dir():
            print(json.dumps({"error": "SUMMARY_OUTPUT_INVALID", "status": "error"}, sort_keys=True))
            return 2
    scope_names = LANE_SCOPES[args.lane]
    for name in scope_names:
        result_output = results_dir / f"{name}.json" if results_dir is not None else None
        command = [sys.executable, "-B", str(Path(__file__).resolve()), "--scope-internal", name]
        if results_dir is not None:
            command.extend(("--base-sha", args.base_sha, "--head-sha", head_sha, "--result-output", str(result_output)))
        completed = subprocess.run(
            command,
            cwd=ROOT,
            env=os.environ.copy(),
            text=True,
            stdout=subprocess.PIPE,
            stderr=None,
            check=False,
        )
        try:
            scope_result = json.loads(completed.stdout)
        except json.JSONDecodeError:
            scope_result = {"outcome": "fail", "scope": name, "tests": 0}
        if (
            set(scope_result) != {"outcome", "scope", "tests"}
            or scope_result["scope"] != name
            or scope_result["outcome"] not in {"pass", "fail"}
            or isinstance(scope_result["tests"], bool)
            or not isinstance(scope_result["tests"], int)
            or scope_result["tests"] < 1
        ):
            scope_result = {"outcome": "fail", "scope": name, "tests": 0}
        counts[name] = scope_result["tests"]
        if completed.returncode != 0 or scope_result["outcome"] != "pass":
            passed = False
    payload = {
        "baseSha": args.base_sha,
        "dependenciesInstalled": False,
        "outcome": "pass" if passed else "fail",
        "schemaVersion": 1,
        "scopes": counts,
        "tests": sum(counts.values()),
    }
    if results_dir is not None:
        manifest = write_manifest(
            results_dir / "manifest.json",
            base_sha=args.base_sha,
            head_sha=head_sha,
            verifier_digest=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
            scope_names=scope_names,
        )
        payload["canonicalResultsDigest"] = manifest["manifestDigest"]
    if args.historical_evidence_output is not None:
        if results_dir is None or not passed:
            print(json.dumps({"error": "HISTORICAL_RESULTS_REQUIRED", "status": "error"}, sort_keys=True))
            return 2
        payload["historicalEvidenceOutcome"] = _run_historical_evidence(results_dir, args.historical_evidence_output)
    if args.host_capability_probe_output is not None:
        payload["hostCapabilityProbeOutcome"] = _run_host_capability_probe(args.host_capability_probe_output)
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n"
    if summary_output is not None:
        summary_output.write_text(encoded, encoding="utf-8")
    print(encoded, end="")
    return 0 if passed else 1


if __name__ == "__main__":
    raise SystemExit(main())
