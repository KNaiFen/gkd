#!/usr/bin/env python3
"""Run the repository-approved zero-dependency local verification contract."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import unittest


ROOT = Path(__file__).resolve().parents[1]
LIBRARY = ROOT / "canonical" / "payload" / "lib"
sys.dont_write_bytecode = True
sys.path.insert(0, str(LIBRARY))
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "src"))


SHA_RE = re.compile(r"^[0-9a-f]{40}$")
SCOPES = (
    ("m5-release-candidate", "tests/release_candidate"),
    ("m4-finalization", "tests/finalization"),
    ("m3-ci-policy", "tests/ci_policy"),
    ("m3-resource-scanner", "tests/resource_scanner"),
    ("m3-review-core", "tests/review_core"),
    ("task-core", "tests/task_core"),
    ("role-routing", "tests/role_routing"),
    ("runtime-bridge", "tests/runtime_bridge"),
    ("foundation", "tests/foundation"),
    ("watcher-core-and-live-negative", "tests/watchdog"),
)


def _git(*arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ("git", *arguments),
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def _run_scope(name: str, relative: str) -> int:
    suite = unittest.defaultTestLoader.discover(
        str(ROOT / relative),
        pattern="test_*.py",
        top_level_dir=str(ROOT),
    )
    result = unittest.TextTestRunner(stream=sys.stderr, verbosity=2, warnings="error").run(suite)
    print(
        json.dumps(
            {
                "outcome": "pass" if result.wasSuccessful() else "fail",
                "scope": name,
                "tests": result.testsRun,
            },
            sort_keys=True,
            separators=(",", ":"),
        )
    )
    return 0 if result.wasSuccessful() else 1


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base-sha")
    parser.add_argument("--scope-internal", choices=[name for name, _ in SCOPES], help=argparse.SUPPRESS)
    args = parser.parse_args()
    os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
    verification_paths = (ROOT / "src", LIBRARY, ROOT)
    os.environ["PYTHONPATH"] = os.pathsep.join(str(path) for path in verification_paths)
    if args.scope_internal is not None:
        relative = dict(SCOPES)[args.scope_internal]
        return _run_scope(args.scope_internal, relative)
    if args.base_sha is None:
        print(json.dumps({"error": "BASE_SHA_INVALID", "status": "error"}, sort_keys=True))
        return 2
    if not SHA_RE.fullmatch(args.base_sha):
        print(json.dumps({"error": "BASE_SHA_INVALID", "status": "error"}, sort_keys=True))
        return 2
    top = _git("rev-parse", "--show-toplevel")
    ancestor = _git("merge-base", "--is-ancestor", args.base_sha, "HEAD")
    if top.returncode != 0 or Path(top.stdout.strip()).resolve() != ROOT or ancestor.returncode != 0:
        print(json.dumps({"error": "BASE_SHA_NOT_ANCESTOR", "status": "error"}, sort_keys=True))
        return 2
    counts: dict[str, int] = {}
    passed = True
    for name, _ in SCOPES:
        completed = subprocess.run(
            (sys.executable, "-B", str(Path(__file__).resolve()), "--scope-internal", name),
            cwd=ROOT,
            env=os.environ.copy(),
            text=True,
            stdout=subprocess.PIPE,
            stderr=None,
            check=False,
        )
        try:
            scope_result = json.loads(completed.stdout)
        except json.JSONDecodeError:
            scope_result = {"outcome": "fail", "scope": name, "tests": 0}
        if (
            set(scope_result) != {"outcome", "scope", "tests"}
            or scope_result["scope"] != name
            or scope_result["outcome"] not in {"pass", "fail"}
            or isinstance(scope_result["tests"], bool)
            or not isinstance(scope_result["tests"], int)
            or scope_result["tests"] < 1
        ):
            scope_result = {"outcome": "fail", "scope": name, "tests": 0}
        counts[name] = scope_result["tests"]
        if completed.returncode != 0 or scope_result["outcome"] != "pass":
            passed = False
    payload = {
        "baseSha": args.base_sha,
        "dependenciesInstalled": False,
        "outcome": "pass" if passed else "fail",
        "schemaVersion": 1,
        "scopes": counts,
        "tests": sum(counts.values()),
    }
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
    return 0 if passed else 1


if __name__ == "__main__":
    raise SystemExit(main())
